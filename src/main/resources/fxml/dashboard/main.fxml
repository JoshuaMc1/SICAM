<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.joshuamc1.sicam.controllers.dashboard.MainController">

    <top>
        <HBox fx:id="topBar" alignment="CENTER_LEFT" prefHeight="70" spacing="20" styleClass="topbar">

            <HBox alignment="CENTER_LEFT" spacing="15">
                <ImageView fx:id="imgLogo" fitHeight="50" fitWidth="50" pickOnBounds="true" preserveRatio="true" />

                <Label styleClass="topbar-org-name" text="SICAM - Sistema de Control de Activos Municipales" />
            </HBox>

            <Region HBox.hgrow="ALWAYS" />

            <VBox alignment="CENTER_RIGHT">

                <Label fx:id="lblCurrentUser" styleClass="topbar-user" text="Nombre Usuario" />

                <Label fx:id="lblCurrentRole" styleClass="topbar-role" text="Rol" />
            </VBox>

            <Button fx:id="btnProfile" styleClass="topbar-profile" text="Mi Perfil" />

            <Button fx:id="btnLogout" styleClass="topbar-logout" text="Cerrar sesión" />

        </HBox>
    </top>

    <left>
        <ScrollPane fitToWidth="true" prefWidth="220" style="-fx-background: #2b2f3a; -fx-background-color: transparent;" styleClass="content-bg">
            <VBox fx:id="sidebar" spacing="10" styleClass="sidebar">
                <padding>
                    <Insets bottom="20" top="20" />
                </padding>

                <Label style="-fx-text-fill: white; -fx-font-size: 18px;" text="Menú" />

                <Button fx:id="btnDashboard" maxWidth="Infinity" styleClass="sidebar-btn" text="Dashboard" />
                <Button fx:id="btnInventory" maxWidth="Infinity" styleClass="sidebar-btn" text="Inventario" />

                <Label fx:id="lblGroupTransactions" style="-fx-text-fill: white; -fx-font-size: 14px; -fx-padding: 10 0 5 0;" text="Transacciones" />
                <Button fx:id="btnIncomes" maxWidth="Infinity" styleClass="sidebar-btn" text="Ingresos" />
                <Button fx:id="btnOutcomes" maxWidth="Infinity" styleClass="sidebar-btn" text="Egresos" />
                <Button fx:id="btnLoans" maxWidth="Infinity" styleClass="sidebar-btn" text="Préstamos" />

                <Label fx:id="lblGroupManagement" style="-fx-text-fill: white; -fx-font-size: 14px; -fx-padding: 10 0 5 0;" text="Gestión" />
                <Button fx:id="btnUsers" maxWidth="Infinity" styleClass="sidebar-btn" text="Usuarios" />
                <Button fx:id="btnRoles" maxWidth="Infinity" styleClass="sidebar-btn" text="Roles" />
                <Button fx:id="btnPeople" maxWidth="Infinity" styleClass="sidebar-btn" text="Personas" />
                <Button fx:id="btnAudit" maxWidth="Infinity" styleClass="sidebar-btn" text="Auditoría" />
                <Button fx:id="btnReports" maxWidth="Infinity" styleClass="sidebar-btn" text="Reportes" />
                <Button fx:id="btnBackup" maxWidth="Infinity" styleClass="sidebar-btn" text="Backup" />
                <Button fx:id="btnAbout" maxWidth="Infinity" styleClass="sidebar-btn" text="Acerca de" VBox.vgrow="ALWAYS" />
            </VBox>
        </ScrollPane>
    </left>

    <center>
        <StackPane fx:id="contentArea" styleClass="content-bg" />
    </center>

</BorderPane>
